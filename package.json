{
  "name": "send-guard",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "发送按钮前的语义隐私防火墙",
  "workspaces": [
    "packages/core",
    "packages/extension"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc -p packages/core && tsc -p packages/extension && tsc -p scripts && tsc -p tests",
    "test": "node --import tsx --test \"tests/unit/*.test.ts\"",
    "calibrate": "tsx scripts/calibrate.ts",
    "package": "npm run build && tsx scripts/package.ts",
    "store:screenshots": "npm run build && tsx scripts/store-screenshots.ts",
    "build:demo": "tsx scripts/build-demo.ts",
    "demo:results": "tsx scripts/demo-results.ts",
    "version:sync": "tsx scripts/version-sync.ts",
    "release": "tsx scripts/release.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
